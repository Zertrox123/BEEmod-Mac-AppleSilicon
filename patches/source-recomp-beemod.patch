diff --git a/tools/puzzlemaker.py b/tools/puzzlemaker.py
index d0971be..82fa9f3 100644
--- a/tools/puzzlemaker.py
+++ b/tools/puzzlemaker.py
@@ -6,6 +6,26 @@ import re
 import tempfile
 
 
+def anchor_relative_game_paths(data, game_dir):
+    """Rewrite plain relative search paths (Game "BEE2", added by BEEmod) to
+    |gameinfo_path|../NAME. Source resolves them from the executable's
+    directory, which is bin/ here, not the game root; and on a
+    case-insensitive disk bin/BEE2 is BEEmod's own bin/bee2 config folder."""
+    pattern = re.compile(rb'(?im)^([ \t]*"?Game"?[ \t]+)"?([A-Za-z0-9_\-. ]+?)"?[ \t]*$')
+
+    def fix(match):
+        name = match[2].decode('utf-8', 'replace')
+        if not name.strip():
+            return match[0]
+        existing = {p.name.casefold(): p.name for p in game_dir.iterdir() if p.is_dir()}
+        real = existing.get(name.casefold())
+        if real is None:
+            return match[0]
+        return match[1] + b'|gameinfo_path|../' + real.encode()
+
+    return pattern.sub(fix, data)
+
+
 def prepare_puzzlemaker(game_dir, user_dir):
     # CBaseFileSystem rejects absolute writes outside its search paths before
     # calling fopen. The editor exports into sdk_content, a sibling of portal2.
@@ -23,6 +43,7 @@ def prepare_puzzlemaker(game_dir, user_dir):
         newline = b'\r\n' if b'\r\n' in data else b'\n'
         entry = newline + search[1] + b'\tSDKCONTENT\t\t|gameinfo_path|../sdk_content'
         data = data[:search.end()] + entry + data[search.end():]
+    data = anchor_relative_game_paths(data, Path(game_dir))
     target.parent.mkdir(parents=True, exist_ok=True)
     if not target.exists() or target.read_bytes() != data:
         out = tempfile.NamedTemporaryFile(dir=target.parent, prefix='.gameinfo.', delete=False)
